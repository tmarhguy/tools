#!/usr/bin/env bash
# Wrapper — Compress Image

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$ROOT/tools/image/compress-image.sh"

if [[ ! -x "$TOOL" ]]; then
  echo "Error: Compress Image tool is not installed yet." >&2
  echo "Expected script: $TOOL" >&2
  exit 1
fi

exec "$TOOL" "$@"

#!/usr/bin/env bash
set -euo pipefail
MANGO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/mango-cli.sh
source "$MANGO_ROOT/lib/mango-cli.sh"
usage() {
  mango_usage "compress-image INPUT [-o OUTPUT] [-q QUALITY]" \
    "Compress a JPEG, PNG, WebP, or GIF image." \
    "  -o, --output   Output path (default: overwrite input)" \
    "  -q, --quality  Quality 1-100 (default: 85)"
}
main() {
  mango_parse_args usage "$@" || return 0
  mango_require_input "$MANGO_INPUT"
  require_python_pkg Pillow Pillow
  local -a args=("$MANGO_INPUT")
  [[ -n "$MANGO_OUTPUT" ]] && args+=(-o "$(mango_abs_path "$MANGO_OUTPUT")")
  [[ -n "$MANGO_QUALITY" ]] && args+=(-q "$MANGO_QUALITY")
  mango_run_python "$MANGO_ROOT/tools/image/compress.py" "${args[@]}"
}
main "$@"

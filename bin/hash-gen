#!/usr/bin/env bash
set -euo pipefail
MANGO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/mango-cli.sh
source "$MANGO_ROOT/lib/mango-cli.sh"
usage() {
  mango_usage "hash-gen INPUT [-a md5|sha1|sha256]" "Generate a file checksum."
}
main() {
  mango_parse_args usage "$@" || return 0
  mango_require_input "$MANGO_INPUT"
  require_python
  local -a args=("$MANGO_INPUT")
  [[ -n "$MANGO_FORMAT" ]] && args+=(-a "$MANGO_FORMAT")
  mango_run_python "$MANGO_ROOT/tools/dev/hash_gen.py" "${args[@]}"
}
main "$@"

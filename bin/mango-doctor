#!/usr/bin/env bash
# Mango doctor — dependency health check

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/mango-deps.sh
source "$ROOT/lib/mango-deps.sh"

QUICK=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quick) QUICK=1; shift ;;
    -h|--help)
      echo "Usage: mango doctor [--quick]"
      echo "  --quick   Batch Python import checks (faster, for setup)"
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

ok=0
warn=0
fail=0

check_ok()   { echo "  ✔ $1"; ((ok++)) || true; }
check_warn() { echo "  ⚠ $1"; ((warn++)) || true; }
check_fail() { echo "  ✖ $1"; ((fail++)) || true; }

echo ""
echo "Mango Doctor"
echo "────────────"
echo ""

# Python
if py="$(mango_python 2>/dev/null)"; then
  ver="$("$py" --version 2>&1)"
  check_ok "Python: $ver ($py)"
else
  check_fail "Python 3 not found"
  echo "     → $(mango_install_hint python)"
fi

# venv
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  check_ok "Virtual env: $ROOT/.venv"
else
  check_warn "No project venv at .venv (using system python3)"
  echo "     → $(mango_install_hint venv)"
fi

# Python packages — one interpreter round-trip when --quick
if [[ "$QUICK" -eq 1 ]] && py="$(mango_python 2>/dev/null)"; then
  while IFS='|' read -r pkg mod status; do
    case "$status" in
      ok)   check_ok "Python package: $pkg" ;;
      fail)
        check_fail "Python package missing: $pkg"
        echo "     → $(mango_install_hint venv)"
        ;;
    esac
  done < <("$py" - <<'PY'
import importlib.util
checks = [
    ("Pillow", "PIL"),
    ("pypdf", "pypdf"),
    ("pdf2docx", "pdf2docx"),
    ("pymupdf", "fitz"),
]
for pkg, mod in checks:
    status = "ok" if importlib.util.find_spec(mod) else "fail"
    print(f"{pkg}|{mod}|{status}")
PY
)
else
  for spec in "Pillow:PIL" "pypdf:pypdf" "pdf2docx:pdf2docx" "pymupdf:fitz"; do
    pkg="${spec%%:*}"
    mod="${spec##*:}"
    if mango_check_python_pkg "$mod" 2>/dev/null; then
      check_ok "Python package: $pkg"
    else
      check_fail "Python package missing: $pkg"
      echo "     → $(mango_install_hint venv)"
    fi
  done
fi

echo ""

# External commands
for spec in "ffmpeg:ffmpeg" "gs:ghostscript"; do
  cmd="${spec%%:*}"
  hint="${spec##*:}"
  if command -v "$cmd" &>/dev/null; then
    check_ok "Command: $cmd ($(command -v "$cmd"))"
  else
    check_warn "Command not found: $cmd (needed for some video/PDF tools)"
    echo "     → $(mango_install_hint "$hint")"
  fi
done

echo ""
echo "Summary: $ok ok, $warn warnings, $fail failures"
echo ""

if [[ "$fail" -gt 0 ]]; then
  exit 1
fi
exit 0

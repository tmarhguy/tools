#!/usr/bin/env bash
set -euo pipefail
MANGO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/mango-cli.sh
source "$MANGO_ROOT/lib/mango-cli.sh"
usage() {
  mango_usage "pdftoword INPUT -o OUTPUT" "Convert a PDF to Word DOCX."
}
main() {
  mango_parse_args usage "$@" || return 0
  mango_require_input "$MANGO_INPUT"
  [[ -n "$MANGO_OUTPUT" ]] || mango_die "Output path is required (-o)."
  require_python_pkg pdf2docx pdf2docx
  mango_run_python "$MANGO_ROOT/tools/pdf/to_word.py" "$MANGO_INPUT" -o "$(mango_abs_path "$MANGO_OUTPUT")"
}
main "$@"

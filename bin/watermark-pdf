#!/usr/bin/env bash
# Wrapper — Watermark PDF

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$ROOT/tools/pdf/watermark-pdf.sh"

if [[ ! -x "$TOOL" ]]; then
  echo "Error: Watermark PDF tool is not installed yet." >&2
  echo "Expected script: $TOOL" >&2
  exit 1
fi

exec "$TOOL" "$@"
